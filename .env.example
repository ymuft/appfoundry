APP_ENV=local
APP_SESSION_NAME=appfoundry_session
APP_SECURE_COOKIES=false

# Relative filesystem paths are resolved from the application root.
# APP_ROOT=/absolute/path/to/application
DB_DRIVER=sqlite
DB_DATABASE=storage/app.sqlite

