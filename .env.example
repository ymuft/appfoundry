APP_ENV=production
APP_NAME=AppFoundry
APP_URL=http://localhost:8080
APP_KEY=change-me-to-a-long-random-value
APP_SESSION_NAME=appfoundry_session
APP_SECURE_COOKIES=false

DB_DRIVER=sqlite
DB_DATABASE=/var/www/html/storage/app.sqlite

